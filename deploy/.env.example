# ==========================================================
# CONFIGURAÇÃO DE PRODUÇÃO - TWENTY CRM + TRAEFIK (EXEMPLO)
# ==========================================================

TAG=latest

# Domínio principal da aplicação (sem https://)
DOMAIN=solucoes-nexus.tech

# URL completa com HTTPS para a aplicação
SERVER_URL=https://solucoes-nexus.tech

# ==========================================================
# SEGURANÇA E CRIPTOGRAFIA
# Gere usando: openssl rand -base64 32
# ==========================================================
ENCRYPTION_KEY=replace_with_openssl_rand_base64_32

# ==========================================================
# BANCO DE DADOS (POSTGRESQL)
# ==========================================================
PG_DATABASE_HOST=db
PG_DATABASE_PORT=5432
PG_DATABASE_USER=postgres
PG_DATABASE_NAME=default
PG_DATABASE_PASSWORD=replace_with_a_strong_password

# ==========================================================
# CACHE E FILAS (REDIS)
# ==========================================================
REDIS_URL=redis://redis:6379

# ==========================================================
# ARMAZENAMENTO DE ARQUIVOS
# ==========================================================
STORAGE_TYPE=local
